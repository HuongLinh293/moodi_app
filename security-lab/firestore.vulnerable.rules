// INTENTIONALLY VULNERABLE TEACHING FIXTURE. EMULATOR ONLY. NEVER DEPLOY.
// Authentication without object-level authorization: every signed-in user
// can access every user's data. This is NOT the original app's rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
