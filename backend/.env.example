# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=moodi_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_REFRESH_EXPIRATION=604800

# File Upload (chỉ JPEG/PNG/GIF/WebP/PDF, kiểm tra magic bytes)
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE=10485760

# Rate limit chung theo IP (lượt/phút). Route đăng nhập/đăng ký: 10/phút cố định.
THROTTLE_LIMIT=300
# Đặt 1 khi chạy sau reverse proxy để lấy đúng IP client
# TRUST_PROXY=1

# Đăng nhập mạng xã hội (để trống = tắt, app sẽ ẩn nút)
# Google: các client ID được chấp nhận làm audience (iOS, Android/Web), cách nhau dấu phẩy
GOOGLE_CLIENT_IDS=
# Apple: bundle ID của app (và Services ID nếu có), cách nhau dấu phẩy
APPLE_CLIENT_IDS=

# Phản tư AI (để trống = dùng template CBT, không gửi dữ liệu ra ngoài)
GEMINI_API_KEY=
# REFLECTION_AI_DISABLED=true

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Email (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
